---
import { ClientRouter } from 'astro:transitions';

// Local fonts - latin + latin-ext only (eliminates external DNS lookup)
// Latin includes æ, ø, å (U+0000-00FF), latin-ext for additional European characters
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';

// Additional fonts for font theme switcher
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';

import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';

import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';

import '@fontsource/dm-serif-display/latin-400.css';

import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-500.css';
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-700.css';

import '@fontsource/sora/latin-400.css';
import '@fontsource/sora/latin-500.css';
import '@fontsource/sora/latin-600.css';
import '@fontsource/sora/latin-700.css';

import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';
import '@fontsource/outfit/latin-700.css';

import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';

import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-500.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/lora/latin-700.css';

import '@fontsource/work-sans/latin-400.css';
import '@fontsource/work-sans/latin-500.css';
import '@fontsource/work-sans/latin-600.css';
import '@fontsource/work-sans/latin-700.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = 'https://efffekt.no/',
} = Astro.props;

const ogImage = Astro.props.ogImage ?? `https://efffekt.no/api/og.png?title=${encodeURIComponent(title)}&description=${encodeURIComponent(description)}`;

import Analytics from '@vercel/analytics/astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LiquidGlass from '../components/common/LiquidGlass.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="no">
<head>
  <!-- Prevent font flash -->
  <script is:inline>
    (function() {
      var savedFont = localStorage.getItem('font-theme');
      if (savedFont && savedFont !== 'modern') {
        document.documentElement.setAttribute('data-font', savedFont);
      }
    })();
  </script>
  <ClientRouter />


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1a1a1a">
  <title>{title}</title>

  <!-- Preload hero image based on time of day -->
  <script is:inline>
    (function() {
      var h = new Date().getHours();
      var p = h >= 6 && h < 12 ? 'morning' : h >= 12 && h < 17 ? 'noon' : h >= 17 && h < 21 ? 'evening' : 'night';
      var link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.type = 'image/webp';
      link.href = '/pastel-hero-' + p + '.webp';
      document.head.appendChild(link);
    })();
  </script>

  <!-- Favicons -->
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Meta -->
  <meta name="description" content={description}>
  <meta name="keywords" content="webutvikler, nettside, webapplikasjon, AI, Norge, EFFFEKT">
  <meta name="author" content="EFFFEKT">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
  <link rel="canonical" href={canonical}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="no_NO">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "EFFFEKT",
    "url": "https://efffekt.no",
    "logo": "https://efffekt.no/android-chrome-512x512.png",
"description": "To utviklere som bygger nettsider, webapplikasjoner og AI-løsninger for norske bedrifter.",
    "email": "sander@efffekt.no",
    "telephone": "+47 451 40 089",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "NO"
    },
    "sameAs": [],
    "founder": [
      {
        "@type": "Person",
        "name": "Sander Martinsen"
      },
      {
        "@type": "Person",
        "name": "Daniel Barlag"
      }
    ],
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "NOK",
      "lowPrice": "9900",
      "highPrice": "44900",
      "offerCount": "4"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "EFFFEKT",
    "image": "https://efffekt.no/api/og.png?title=EFFFEKT",
    "url": "https://efffekt.no",
    "telephone": "+47 451 40 089",
    "email": "sander@efffekt.no",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "NO"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "59.9139",
      "longitude": "10.7522"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Norway"
    },
    "serviceType": ["Web Development", "Web Application Development", "AI Integration"]
  }
  </script>

  <slot name="head" />

  <!-- Facebook Pixel + Conversions API deduplication -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2400693193732959');

    // Helper: get _fbp / _fbc cookies
    function getFbCookie(name) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    }

    // Helper: generate unique event ID
    function genEventId() {
      return Date.now().toString(36) + '.' + Math.random().toString(36).slice(2, 10);
    }

    // Send event to both pixel (browser) and Conversions API (server)
    function sendFbEvent(eventName, userData) {
      var eventId = genEventId();

      // Browser-side pixel with eventID for dedup
      fbq('track', eventName, {}, { eventID: eventId });

      // Server-side via our API route
      var payload = {
        event_name: eventName,
        event_id: eventId,
        event_source_url: window.location.href,
        user_data: Object.assign({
          fbp: getFbCookie('_fbp'),
          fbc: getFbCookie('_fbc')
        }, userData || {})
      };

      navigator.sendBeacon('/api/fb-event', JSON.stringify(payload));
    }

    // Track PageView on initial load
    sendFbEvent('PageView');

    // Track PageView on View Transitions (SPA navigation)
    document.addEventListener('astro:page-load', function() {
      sendFbEvent('PageView');
    });

    // Expose for use in contact form (Lead event)
    window.__sendFbEvent = sendFbEvent;
  </script>
  <noscript>
    <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2400693193732959&ev=PageView&noscript=1" />
  </noscript>

  <!-- Microsoft Clarity - deferred to reduce critical path -->
  <script is:inline>
    (function() {
      function loadClarity() {
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "v3kg6mttab");
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadClarity);
      } else {
        setTimeout(loadClarity, 2000);
      }
    })();
  </script>
</head>
<body>
  <!-- Intro Animation Controller -->
  <script is:inline>
    function initIntro() {
      // Skip intro if already seen this session or on navigation
      const hasSeenIntro = sessionStorage.getItem('intro-seen');
      const isNavigation = window.performance && window.performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (hasSeenIntro || isNavigation || prefersReducedMotion) {
        return;
      }

      // Mark intro as seen
      sessionStorage.setItem('intro-seen', 'true');
    }

    initIntro();
    document.addEventListener('astro:page-load', initIntro);
  </script>

  <a href="#main-content" class="skip-link">Hopp til hovedinnhold</a>

  <Header transition:persist />

  <main id="main-content" transition:animate="fade">
    <slot />
  </main>

  <Footer transition:persist />

  <slot name="scripts" />
  <Analytics />
  <LiquidGlass />

  <script>
    function initSplitWords() {
      document.querySelectorAll('.split-words').forEach(el => {
        if (el.querySelector('.word')) return;
        const text = el.textContent || '';
        el.innerHTML = text.split(/\s+/).filter(Boolean).map(w =>
          `<span class="word">${w}</span>`
        ).join(' ');
      });
    }
    initSplitWords();
    document.addEventListener('astro:page-load', initSplitWords);
  </script>

  <script>
    function initSplitLetters() {
      document.querySelectorAll('.split-letters').forEach(el => {
        if (el.querySelector('.letter')) return;
        const text = el.textContent || '';
        el.innerHTML = text.split('').map(ch =>
          ch === ' ' ? ' ' : `<span class="letter">${ch}</span>`
        ).join('');
      });
    }
    initSplitLetters();
    document.addEventListener('astro:page-load', initSplitLetters);
  </script>

  <script>
    function initGlobalReveal() {
      const els = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger, .reveal-hero, .reveal-elegant, .reveal-fade, .split-words, .split-letters, .text-underline-draw'
      );
      if (!els.length) return;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '-50px' });
      els.forEach(el => observer.observe(el));
    }
    initGlobalReveal();
    document.addEventListener('astro:page-load', initGlobalReveal);
  </script>
</body>
</html>
