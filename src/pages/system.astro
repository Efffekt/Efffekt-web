---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

const faqItems = [
  {
    question: "Hvor lang tid tar utvikling?",
    answer: "Et typisk system tar 4-8 uker fra start til ferdig. Du får en fungerende demo innen 2 uker, slik at du kan se retningen før du betaler noe."
  },
  {
    question: "Kan dere integrere med eksisterende systemer?",
    answer: "Ja! Vi har erfaring med å koble på regnskapssystemer, e-post, kalendere, betalingsløsninger og andre verktøy bedriften din allerede bruker."
  },
  {
    question: "Er det bindingstid?",
    answer: "Nei, ingen bindingstid. Du kan avslutte når som helst. Vi tror på å levere verdi hver måned, ikke låse deg inne i lange kontrakter."
  },
  {
    question: "Hva er inkludert?",
    answer: "Alt du trenger: utvikling, hosting, SSL, vedlikehold, sikkerhetsoppdateringer, backup og support. Du trenger ikke tenke på noe teknisk."
  }
];
---

<BaseLayout
  title="Skreddersydd System | EFFFEKT"
  description="Skreddersydde systemløsninger for norske bedrifter. Kundeoversikt, automatisering og full kontroll. Ingen bindingstid."
  canonical="https://efffekt.no/system"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Skreddersydd System",
      "description": "Skreddersydde systemløsninger for norske bedrifter. Kundeoversikt, automatisering, PDF-generering og dashboard.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "EFFFEKT",
        "url": "https://efffekt.no"
      },
      "areaServed": { "@type": "Country", "name": "Norge" },
      "offers": { "@type": "Offer", "price": "44900", "priceCurrency": "NOK" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <span class="section-label">Tjeneste</span>
        <p class="editorial-statement split-words">Slutt på Excel-kaos</p>
        <p class="editorial-body">Få alt på ett sted. Kundeoversikt, automatiske påminnelser og full kontroll — uten å tape oversikten.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-header reveal">
        <span class="section-label">Hva er inkludert</span>
        <h2 class="efffekt-bar">Alt du trenger for full kontroll</h2>
      </div>
      <div class="included-grid reveal-stagger">
        <div class="included-item">
          <div class="included-icon"><Icon name="users" size={24} /></div>
          <h3>Kunde- og prosjektoversikt</h3>
          <p>All informasjon samlet på ett sted. Søk, filtrer og finn det du trenger raskt.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="bell" size={24} /></div>
          <h3>Automatiske varsler</h3>
          <p>Påminnelser for forfall, oppgaver og viktige datoer. Aldri glem noe igjen.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="file-pdf" size={24} /></div>
          <h3>PDF-generering</h3>
          <p>Lag rapporter, fakturaer og dokumenter med ett klikk.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="mobile-alt" size={24} /></div>
          <h3>Mobilvennlig dashboard</h3>
          <p>Full tilgang fra mobil og nettbrett. Jobb fra hvor som helst.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="user-lock" size={24} /></div>
          <h3>Brukerinnlogging og roller</h3>
          <p>Gi ansatte tilgang til det de trenger. Administrator, bruker, kun lesning.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="plug" size={24} /></div>
          <h3>Integrasjoner</h3>
          <p>Koble på e-post, kalender, regnskap og andre verktøy du allerede bruker.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <p class="editorial-statement split-words">Vanlige spørsmål</p>
          <p class="editorial-body">Alt du lurer på om skreddersydde systemer.</p>
          <a href="/#kontakt" class="faq-cta-link">
            Spør oss direkte
            <span class="faq-cta-circle"><Icon name="arrow-right" size={12} /></span>
          </a>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <Icon name="chevron-down" size={20} />
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="other-services">
    <div class="container">
      <div class="other-services-header reveal">
        <span class="section-label">Andre tjenester</span>
        <h2 class="efffekt-bar">Se hva mer vi kan hjelpe med</h2>
      </div>
      <div class="other-services-grid reveal-stagger">
        <a href="/nettside" class="other-service-card">
          <Icon name="globe" size={24} />
          <h3>Nettside</h3>
          <p class="other-desc">Nettsider som konverterer</p>
        </a>
        <a href="/integrasjon" class="other-service-card">
          <Icon name="plug" size={24} />
          <h3>Integrasjon</h3>
          <p class="other-desc">Koble systemene dine sammen</p>
        </a>
        <a href="/ai" class="other-service-card">
          <Icon name="robot" size={24} />
          <h3>AI-automatisering</h3>
          <p class="other-desc">Automatiser repeterende oppgaver</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="service-cta-section">
    <div class="container">
      <div class="service-cta-band reveal">
        <p class="editorial-statement split-words">Klar for et nytt system?</p>
        <p class="editorial-body">Ta kontakt for en uforpliktende samtale. Vi svarer innen 24 timer.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <script>
    function initServicePage() {
      const revealElements = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger'
      );
      const revealOnScroll = () => {
        const windowHeight = window.innerHeight;
        revealElements.forEach(el => {
          const elementTop = el.getBoundingClientRect().top;
          if (elementTop < windowHeight * 0.85) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      revealOnScroll();
    }
    initServicePage();
    document.addEventListener('astro:page-load', initServicePage);
  </script>

  <script is:inline>
    if (!window.__faqInitialized) {
      window.__faqInitialized = true;
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.faq-question');
        if (!btn) return;
        e.preventDefault();
        var item = btn.parentElement;
        if (!item) return;
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          var elBtn = el.querySelector('.faq-question');
          if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  </script>
</BaseLayout>
