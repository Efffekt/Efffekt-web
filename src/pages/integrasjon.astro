---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

const faqItems = [
  {
    question: "Hvilke systemer kan dere integrere?",
    answer: "Vi har erfaring med de fleste vanlige systemer: Tripletex, Fiken, Visma, HubSpot, Mailchimp, Shopify, WooCommerce, og mange flere. Har du et system som ikke er nevnt? Vi finner en løsning."
  },
  {
    question: "Hvor lang tid tar en integrasjon?",
    answer: "En standard integrasjon tar vanligvis 1-3 uker avhengig av kompleksitet. Du får en fungerende demo innen en uke som viser hvordan dataflyten vil fungere."
  },
  {
    question: "Er det trygt å koble sammen systemer?",
    answer: "Ja! Vi bruker sikre koblinger med kryptering. All dataoverføring logges, og vi setter opp varsler hvis noe går galt. Data forblir hos deg — vi lagrer ingenting."
  },
  {
    question: "Hva skjer hvis noe går galt?",
    answer: "Vi bygger inn automatisk feilhåndtering og varsler. Hvis en integrasjon feiler, får du beskjed med en gang. Overvåkning og feilretting er inkludert."
  },
  {
    question: "Kan jeg endre integrasjonene senere?",
    answer: "Ja! Integrasjoner kan justeres når som helst. Trenger du å koble på et nytt system eller endre dataflyt? Det er inkludert."
  }
];
---

<BaseLayout
  title="Integrasjon | EFFFEKT"
  description="Koble systemene dine sammen. Data flyter automatisk, alltid oppdatert. Overvåkning og vedlikehold inkludert. Ingen bindingstid."
  canonical="https://efffekt.no/integrasjon"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Systemintegrasjon",
      "description": "Koble systemene dine sammen med skreddersydde løsninger. Data flyter automatisk mellom systemene dine, alltid oppdatert.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "EFFFEKT",
        "url": "https://efffekt.no"
      },
      "areaServed": { "@type": "Country", "name": "Norge" },
      "offers": { "@type": "Offer", "price": "7900", "priceCurrency": "NOK" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <p class="editorial-statement split-words">Koble systemene sammen</p>
        <p class="editorial-body">Slutt på manuell dataoverføring. La systemene snakke sammen automatisk — spar tid og unngå feil.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-header reveal">
        <span class="section-label">Hva er inkludert</span>
        <h2 class="efffekt-bar">Alt du trenger for sømløs integrasjon</h2>
      </div>
      <div class="included-grid reveal-stagger">
        <div class="included-item">
          <div class="included-icon"><Icon name="plug" size={24} /></div>
          <h3>Systemkoblinger</h3>
          <p>Skreddersydde koblinger mot systemene du bruker. Vi ordner det tekniske.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="sync" size={24} /></div>
          <h3>Automatisk dataflyt</h3>
          <p>Data overføres automatisk mellom systemene. Ingen manuell kopiering eller eksport/import.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="bolt" size={24} /></div>
          <h3>Alltid oppdatert</h3>
          <p>Endringer oppdateres umiddelbart i alle systemer. Alltid riktig informasjon.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="chart-line" size={24} /></div>
          <h3>Overvåkning inkludert</h3>
          <p>Vi overvåker integrasjonene 24/7. Får beskjed om problemer før du merker noe.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="exclamation-triangle" size={24} /></div>
          <h3>Feilhåndtering</h3>
          <p>Automatisk retry ved feil. Logging og varsler slik at ingenting går tapt.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="shield-alt" size={24} /></div>
          <h3>Sikker datautveksling</h3>
          <p>Sikker dataoverføring. Følger personvernloven og gir full oversikt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <p class="editorial-statement split-words">Vanlige spørsmål</p>
          <p class="editorial-body">Alt du lurer på om integrasjoner.</p>
          <a href="/#kontakt" class="faq-cta-link">
            Spør oss direkte
            <span class="faq-cta-circle"><Icon name="arrow-right" size={12} /></span>
          </a>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <Icon name="chevron-down" size={20} />
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="other-services">
    <div class="container">
      <div class="other-services-header reveal">
        <span class="section-label">Andre tjenester</span>
        <h2 class="efffekt-bar">Se hva mer vi kan hjelpe med</h2>
      </div>
      <div class="other-services-grid reveal-stagger">
        <a href="/nettside" class="other-service-card">
          <Icon name="globe" size={24} />
          <h3>Nettside</h3>
          <p class="other-desc">Nettsider som konverterer</p>
        </a>
        <a href="/plugin" class="other-service-card">
          <Icon name="laptop-code" size={24} />
          <h3>Plugin</h3>
          <p class="other-desc">Utvid systemene du allerede har</p>
        </a>
        <a href="/ai" class="other-service-card">
          <Icon name="robot" size={24} />
          <h3>AI-automatisering</h3>
          <p class="other-desc">Automatiser repeterende oppgaver</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="service-cta-section">
    <div class="container">
      <div class="service-cta-band reveal">
        <p class="editorial-statement split-words">Klar for å koble sammen?</p>
        <p class="editorial-body">Ta kontakt for en uforpliktende samtale. Vi svarer innen 24 timer.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <script>
    function initServicePage() {
      const revealElements = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger'
      );
      const revealOnScroll = () => {
        const windowHeight = window.innerHeight;
        revealElements.forEach(el => {
          const elementTop = el.getBoundingClientRect().top;
          if (elementTop < windowHeight * 0.85) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      revealOnScroll();
    }
    initServicePage();
    document.addEventListener('astro:page-load', initServicePage);
  </script>

  <script is:inline>
    if (!window.__faqInitialized) {
      window.__faqInitialized = true;
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.faq-question');
        if (!btn) return;
        e.preventDefault();
        var item = btn.parentElement;
        if (!item) return;
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          var elBtn = el.querySelector('.faq-question');
          if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  </script>
</BaseLayout>
