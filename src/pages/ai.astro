---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

const faqItems = [
  {
    question: "Hva kan AI faktisk gjøre for min bedrift?",
    answer: "AI kan automatisere repetitive oppgaver som å svare på kundehenvendelser, sortere e-post, generere dokumenter, og søke i bedriftens data."
  },
  {
    question: "Er det trygt å bruke AI med kundedata?",
    answer: "Ja! Vi setter opp alt GDPR-vennlig. Data forblir i Norge/EU, og vi bruker kun sikre, dokumenterte løsninger. Ingen data sendes til tredjeparter uten din godkjenning."
  },
  {
    question: "Trenger jeg teknisk kompetanse?",
    answer: "Nei. Vi lager brukergrensesnitt som er like enkle å bruke som vanlige apper. Du trenger ikke kode eller teknisk bakgrunn — bare fortelle AI hva du vil."
  },
  {
    question: "Kan AI integreres med systemene vi allerede har?",
    answer: "Ja! Vi har erfaring med å koble AI til CRM-systemer, e-post, kundesystemer og nettsider. AI-en kan bruke data fra dine eksisterende løsninger."
  },
  {
    question: "Er det bindingstid?",
    answer: "Nei, ingen bindingstid. Alt er inkludert — utvikling, hosting, vedlikehold og API-kostnader. Avslutt når du vil."
  }
];
---

<BaseLayout
  title="AI-automatisering | EFFFEKT"
  description="AI-løsninger for norske bedrifter. Chatbot, automatisering og smart dokumenthåndtering. GDPR-vennlig. Ingen bindingstid."
  canonical="https://efffekt.no/ai"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "AI-integrasjon",
      "description": "AI-løsninger for norske bedrifter. Chatbot, automatisering, smart dokumentgenerering og naturlig språk-søk.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "EFFFEKT",
        "url": "https://efffekt.no"
      },
      "areaServed": { "@type": "Country", "name": "Norge" },
      "offers": { "@type": "Offer", "price": "9900", "priceCurrency": "NOK" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <p class="editorial-statement split-words">AI som faktisk hjelper</p>
        <p class="editorial-body">Automatiser repeterende oppgaver og la teamet fokusere på det som betyr noe. GDPR-vennlig og tilpasset din bedrift.</p>
        <p class="service-price">Fra kr 9 900</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Book en gratis prat</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-header reveal">
        <span class="section-label">Hva er inkludert</span>
        <h2 class="efffekt-bar">Alt du trenger for smart automatisering</h2>
      </div>
      <div class="included-grid reveal-stagger">
        <div class="included-item">
          <div class="included-icon"><Icon name="robot" size={24} /></div>
          <h3>Chatbot 24/7</h3>
          <p>AI som svarer kunder når som helst. Basert på din bedrifts informasjon.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="sort" size={24} /></div>
          <h3>Automatisk sortering</h3>
          <p>Henvendelser kategoriseres og prioriteres automatisk. Viktige saker får først.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="file-alt" size={24} /></div>
          <h3>Dokumentgenerering</h3>
          <p>Lag kontrakter, rapporter og e-poster med AI. Spar timer på skrivearbeid.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="search" size={24} /></div>
          <h3>Naturlig språk-søk</h3>
          <p>Søk i bedriftens data med vanlige setninger. Finn alt du trenger raskt.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="plug" size={24} /></div>
          <h3>Integrasjoner</h3>
          <p>Kobles på nettsiden, CRM, e-post og andre systemer du allerede bruker.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="shield-alt" size={24} /></div>
          <h3>GDPR-vennlig</h3>
          <p>All data i Norge/EU. Dokumentert og trygt oppsett for norske bedrifter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <p class="editorial-statement split-words">Vanlige spørsmål</p>
          <p class="editorial-body">Alt du lurer på om AI-løsninger.</p>
          <a href="/#kontakt" class="faq-cta-link">
            Spør oss direkte
            <span class="faq-cta-circle"><Icon name="arrow-right" size={12} /></span>
          </a>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <Icon name="chevron-down" size={20} />
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="other-services">
    <div class="container">
      <div class="other-services-header reveal">
        <span class="section-label">Andre tjenester</span>
        <h2 class="efffekt-bar">Se hva mer vi kan hjelpe med</h2>
      </div>
      <div class="other-services-grid reveal-stagger">
        <a href="/nettside" class="other-service-card">
          <Icon name="globe" size={24} />
          <h3>Nettside</h3>
          <p class="other-desc">Nettsider som konverterer</p>
        </a>
        <a href="/integrasjon" class="other-service-card">
          <Icon name="plug" size={24} />
          <h3>Integrasjon</h3>
          <p class="other-desc">Koble systemene dine sammen</p>
        </a>
        <a href="/plugin" class="other-service-card">
          <Icon name="laptop-code" size={24} />
          <h3>Plugin</h3>
          <p class="other-desc">Utvid systemene du allerede har</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="service-cta-section">
    <div class="container">
      <div class="service-cta-band reveal">
        <p class="editorial-statement split-words">Klar for AI?</p>
        <p class="editorial-body">Ta kontakt for en uforpliktende samtale. Vi svarer innen 24 timer.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Snakk med oss</a>
      </div>
    </div>
  </section>

  <script>
    function initServicePage() {
      const revealElements = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger'
      );
      const revealOnScroll = () => {
        const windowHeight = window.innerHeight;
        revealElements.forEach(el => {
          const elementTop = el.getBoundingClientRect().top;
          if (elementTop < windowHeight * 0.85) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      revealOnScroll();
    }
    initServicePage();
    document.addEventListener('astro:page-load', initServicePage);
  </script>

  <script is:inline>
    if (!window.__faqInitialized) {
      window.__faqInitialized = true;
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.faq-question');
        if (!btn) return;
        e.preventDefault();
        var item = btn.parentElement;
        if (!item) return;
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          var elBtn = el.querySelector('.faq-question');
          if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  </script>
</BaseLayout>
