---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

const faqItems = [
  {
    question: "Hvor lang tid tar det å lage en nettside?",
    answer: "En standard nettside tar vanligvis 1-2 uker fra oppstart til lansering. Du får en fungerende demo innen 2-7 dager som du kan teste før du bestemmer deg."
  },
  {
    question: "Hva er inkludert?",
    answer: "Alt du trenger: design, utvikling, hosting, SSL-sertifikat, vedlikehold og oppdateringer. Du trenger ikke tenke på noe teknisk — vi tar oss av det."
  },
  {
    question: "Er det bindingstid?",
    answer: "Nei, ingen bindingstid. Du kan avslutte når som helst. Vi tror på å levere verdi hver måned, ikke låse deg inne i lange kontrakter."
  },
  {
    question: "Kan jeg oppdatere nettsiden selv?",
    answer: "Ja! Vi kan sette opp et enkelt CMS slik at du kan endre tekst og bilder selv. Eller så gjør vi endringene for deg — det er inkludert."
  },
  {
    question: "Hva om jeg ikke liker resultatet?",
    answer: "Du får en gratis demo først, og betaler ingenting hvis du ikke er fornøyd. Vi starter ikke på full utvikling før du har godkjent demoen."
  }
];
---

<BaseLayout
  title="Profesjonell Nettside | EFFFEKT"
  description="Profesjonelle nettsider for norske bedrifter. SEO-optimalisert, responsivt design, vedlikehold inkludert. Ingen bindingstid."
  canonical="https://efffekt.no/nettside"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Profesjonell Nettside",
      "description": "Profesjonelle nettsider for norske bedrifter. Responsivt design, SEO-optimalisert, kontaktskjema, og rask lasting.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "EFFFEKT",
        "url": "https://efffekt.no"
      },
      "areaServed": { "@type": "Country", "name": "Norge" },
      "offers": { "@type": "Offer", "price": "14900", "priceCurrency": "NOK" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <p class="editorial-statement split-words">En nettside som jobber for deg</p>
        <p class="editorial-body">Rask, mobilvennlig og bygget for å konvertere besøkende til kunder. Alt inkludert — ingen bindingstid.</p>
        <p class="service-price">Fra kr 14 900</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Book en gratis prat</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-header reveal">
        <span class="section-label">Hva er inkludert</span>
        <h2 class="efffekt-bar">Alt du trenger for en profesjonell nettside</h2>
      </div>
      <div class="included-grid reveal-stagger">
        <div class="included-item">
          <div class="included-icon"><Icon name="palette" size={24} /></div>
          <h3>Skreddersydd design</h3>
          <p>Tilpasset din merkevare og bransje. Ikke en ferdig mal alle andre bruker.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="mobile-alt" size={24} /></div>
          <h3>Fungerer overalt</h3>
          <p>Responsivt design som ser bra ut på mobil, nettbrett og PC.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="search" size={24} /></div>
          <h3>Google-synlig</h3>
          <p>SEO-optimalisert slik at kunder faktisk finner deg.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="envelope" size={24} /></div>
          <h3>Kontaktskjema</h3>
          <p>Henvendelser sendes rett til din e-post. Enkelt og effektivt.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="bolt" size={24} /></div>
          <h3>Rask lasting</h3>
          <p>Optimalisert for hastighet. Ingen venter på trege sider.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="lock" size={24} /></div>
          <h3>SSL-sertifikat</h3>
          <p>Hengelås i nettleseren. Trygt for deg og kundene.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <p class="editorial-statement split-words">Vanlige spørsmål</p>
          <p class="editorial-body">Alt du lurer på om nettsider.</p>
          <a href="/#kontakt" class="faq-cta-link">
            Spør oss direkte
            <span class="faq-cta-circle"><Icon name="arrow-right" size={12} /></span>
          </a>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <Icon name="chevron-down" size={20} />
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="other-services">
    <div class="container">
      <div class="other-services-header reveal">
        <span class="section-label">Andre tjenester</span>
        <h2 class="efffekt-bar">Se hva mer vi kan hjelpe med</h2>
      </div>
      <div class="other-services-grid reveal-stagger">
        <a href="/integrasjon" class="other-service-card">
          <Icon name="plug" size={24} />
          <h3>Integrasjon</h3>
          <p class="other-desc">Koble systemene dine sammen</p>
        </a>
        <a href="/plugin" class="other-service-card">
          <Icon name="laptop-code" size={24} />
          <h3>Plugin</h3>
          <p class="other-desc">Utvid systemene du allerede har</p>
        </a>
        <a href="/ai" class="other-service-card">
          <Icon name="robot" size={24} />
          <h3>AI-automatisering</h3>
          <p class="other-desc">Automatiser repeterende oppgaver</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="service-cta-section">
    <div class="container">
      <div class="service-cta-band reveal">
        <p class="editorial-statement split-words">Klar for en ny nettside?</p>
        <p class="editorial-body">Ta kontakt for en uforpliktende samtale. Vi svarer innen 24 timer.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Snakk med oss</a>
      </div>
    </div>
  </section>

  <script>
    function initServicePage() {
      const revealElements = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger'
      );
      const revealOnScroll = () => {
        const windowHeight = window.innerHeight;
        revealElements.forEach(el => {
          const elementTop = el.getBoundingClientRect().top;
          if (elementTop < windowHeight * 0.85) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      revealOnScroll();
    }
    initServicePage();
    document.addEventListener('astro:page-load', initServicePage);
  </script>

  <script is:inline>
    if (!window.__faqInitialized) {
      window.__faqInitialized = true;
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.faq-question');
        if (!btn) return;
        e.preventDefault();
        var item = btn.parentElement;
        if (!item) return;
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          var elBtn = el.querySelector('.faq-question');
          if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  </script>
</BaseLayout>
