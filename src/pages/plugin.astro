---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';

const faqItems = [
  {
    question: "Hva er en plugin?",
    answer: "En plugin er en tilleggsmodul som utvider funksjonaliteten til et eksisterende system. Vi bygger skreddersydde plugins for WordPress, Shopify, WooCommerce og andre plattformer."
  },
  {
    question: "Hvilke plattformer støtter dere?",
    answer: "Vi har erfaring med WordPress, WooCommerce, Shopify, Magento, og flere. Har du en annen plattform? Ta kontakt — vi finner en løsning."
  },
  {
    question: "Hvordan håndteres oppdateringer?",
    answer: "Vi sørger for at pluginen er kompatibel med nye versjoner av plattformen din. Oppdateringer og feilrettinger er inkludert."
  },
  {
    question: "Kan jeg få støtte hvis noe ikke fungerer?",
    answer: "Ja! Support er alltid inkludert. Vi hjelper deg med installasjon, konfigurasjon og eventuelle problemer som oppstår."
  },
  {
    question: "Er det bindingstid?",
    answer: "Nei, ingen bindingstid. Du kan avslutte når som helst. Vi tror på å levere verdi hver måned, ikke låse deg inne i lange kontrakter."
  }
];
---

<BaseLayout
  title="Plugin | EFFFEKT"
  description="Skreddersydde plugins for WordPress, Shopify og andre plattformer. Utvid funksjonaliteten til ditt eksisterende system. Ingen bindingstid."
  canonical="https://efffekt.no/plugin"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Skreddersydd Plugin",
      "description": "Skreddersydde plugins som utvider funksjonaliteten til ditt eksisterende system. WordPress, Shopify, WooCommerce og mer.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "EFFFEKT",
        "url": "https://efffekt.no"
      },
      "areaServed": { "@type": "Country", "name": "Norge" },
      "offers": { "@type": "Offer", "price": "6490", "priceCurrency": "NOK" }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": { "@type": "Answer", "text": item.answer }
      }))
    })} />
  </Fragment>

  <!-- Hero Section -->
  <section class="service-hero">
    <div class="container">
      <div class="service-hero-content reveal">
        <p class="editorial-statement split-words">Utvid mulighetene</p>
        <p class="editorial-body">Få funksjonaliteten du trenger — uten å bytte system. Skreddersydde plugins som passer perfekt inn.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="service-details">
    <div class="container">
      <div class="service-details-header reveal">
        <span class="section-label">Hva er inkludert</span>
        <h2 class="efffekt-bar">Alt du trenger for en skreddersydd plugin</h2>
      </div>
      <div class="included-grid reveal-stagger">
        <div class="included-item">
          <div class="included-icon"><Icon name="puzzle-piece" size={24} /></div>
          <h3>Skreddersydd funksjonalitet</h3>
          <p>Plugin bygget for akkurat dine behov. Ikke en standard løsning med funksjoner du ikke trenger.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="plug" size={24} /></div>
          <h3>Integrer med ditt system</h3>
          <p>Fungerer sømløst med WordPress, Shopify, WooCommerce eller din valgte plattform.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="sync" size={24} /></div>
          <h3>Enkel oppdatering</h3>
          <p>Vi holder pluginen oppdatert og kompatibel med nye versjoner av plattformen.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="headset" size={24} /></div>
          <h3>Support inkludert</h3>
          <p>Hjelp med installasjon, konfigurasjon og eventuelle spørsmål. Vi er her for deg.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="code" size={24} /></div>
          <h3>Dokumentert kode</h3>
          <p>Ryddig og dokumentert kode som er enkel å forstå og vedlikeholde.</p>
        </div>
        <div class="included-item">
          <div class="included-icon"><Icon name="check-circle" size={24} /></div>
          <h3>Testing inkludert</h3>
          <p>Grundig testet før lansering. Vi sørger for at alt fungerer som det skal.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-left reveal">
          <p class="editorial-statement split-words">Vanlige spørsmål</p>
          <p class="editorial-body">Alt du lurer på om plugins.</p>
          <a href="/#kontakt" class="faq-cta-link">
            Spør oss direkte
            <span class="faq-cta-circle"><Icon name="arrow-right" size={12} /></span>
          </a>
        </div>
        <div class="faq-list">
          {faqItems.map((item, index) => (
            <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <Icon name="chevron-down" size={20} />
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services -->
  <section class="other-services">
    <div class="container">
      <div class="other-services-header reveal">
        <span class="section-label">Andre tjenester</span>
        <h2 class="efffekt-bar">Se hva mer vi kan hjelpe med</h2>
      </div>
      <div class="other-services-grid reveal-stagger">
        <a href="/nettside" class="other-service-card">
          <Icon name="globe" size={24} />
          <h3>Nettside</h3>
          <p class="other-desc">Nettsider som konverterer</p>
        </a>
        <a href="/integrasjon" class="other-service-card">
          <Icon name="plug" size={24} />
          <h3>Integrasjon</h3>
          <p class="other-desc">Koble systemene dine sammen</p>
        </a>
        <a href="/ai" class="other-service-card">
          <Icon name="robot" size={24} />
          <h3>AI-automatisering</h3>
          <p class="other-desc">Automatiser repeterende oppgaver</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="service-cta-section">
    <div class="container">
      <div class="service-cta-band reveal">
        <p class="editorial-statement split-words">Klar for en ny plugin?</p>
        <p class="editorial-body">Ta kontakt for en uforpliktende samtale. Vi svarer innen 24 timer.</p>
        <a href="/#kontakt" class="btn btn-primary btn-large">Ta kontakt</a>
      </div>
    </div>
  </section>

  <script>
    function initServicePage() {
      const revealElements = document.querySelectorAll(
        '.reveal, .reveal-scale, .reveal-left, .reveal-right, .reveal-mask, .reveal-stagger'
      );
      const revealOnScroll = () => {
        const windowHeight = window.innerHeight;
        revealElements.forEach(el => {
          const elementTop = el.getBoundingClientRect().top;
          if (elementTop < windowHeight * 0.85) {
            el.classList.add('visible');
          }
        });
      };
      window.addEventListener('scroll', revealOnScroll, { passive: true });
      revealOnScroll();
    }
    initServicePage();
    document.addEventListener('astro:page-load', initServicePage);
  </script>

  <script is:inline>
    if (!window.__faqInitialized) {
      window.__faqInitialized = true;
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.faq-question');
        if (!btn) return;
        e.preventDefault();
        var item = btn.parentElement;
        if (!item) return;
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          var elBtn = el.querySelector('.faq-question');
          if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  </script>
</BaseLayout>
