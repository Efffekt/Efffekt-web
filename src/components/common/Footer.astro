---
// Footer component with time-of-day background
---

<div class="footer-divider" aria-hidden="true">
  <span class="divider-line line-1"></span>
  <span class="divider-line line-2"></span>
  <span class="divider-line line-3"></span>
  <span class="divider-line line-4"></span>
  <span class="divider-line line-5"></span>
</div>
<footer class="footer" id="site-footer">
  <div class="container">
    <a href="/" class="logo">
      <span class="logo-text logo-text-lg">Efffekt</span>
    </a>
    <div class="footer-legal">
      <a href="/personvern">Personvern</a>
      <a href="/vilkar">Vilkår</a>
    </div>
  </div>
</footer>

<script>
  function initFooterTod(): void {
    const footer = document.getElementById('site-footer');
    if (!footer) return;

    // Check if the hero already has a period set (from hero's initTimeOfDay)
    const heroBg = document.querySelector('.hero-bg') as HTMLElement;
    if (heroBg) {
      const existing = heroBg.getAttribute('data-timeofday');
      if (existing) {
        footer.setAttribute('data-timeofday', existing);
        document.documentElement.setAttribute('data-timeofday', existing);
        return;
      }
    }

    // Fallback: determine period ourselves
    const hour = new Date().getHours();
    let period: string;
    if (hour >= 6 && hour < 12) {
      period = 'morning';
    } else if (hour >= 12 && hour < 17) {
      period = 'noon';
    } else if (hour >= 17 && hour < 21) {
      period = 'evening';
    } else {
      period = 'night';
    }
    footer.setAttribute('data-timeofday', period);
    document.documentElement.setAttribute('data-timeofday', period);
  }

  initFooterTod();
  document.addEventListener('astro:page-load', initFooterTod);
</script>

<style>
  /* ── Divider lines (transition to footer) ── */
  .footer-divider {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--bg-elevated);
  }

  .footer-divider .divider-line {
    display: block;
    width: 100%;
    height: 7px;
  }

  /* line-1 is at top (closest to section), fading to tod color at line-5 */
  .footer-divider .line-1 { background: rgba(var(--divider-rgb), 0.05); }
  .footer-divider .line-2 { background: rgba(var(--divider-rgb), 0.15); }
  .footer-divider .line-3 { background: rgba(var(--divider-rgb), 0.35); }
  .footer-divider .line-4 { background: rgba(var(--divider-rgb), 0.65); }
  .footer-divider .line-5 { background: rgba(var(--divider-rgb), 1); }

  .footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    padding: 60px 0 4px;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 85%;
    background-repeat: no-repeat;
    background-image: url('/pastel-footer-night.png');
  }

  .footer[data-timeofday="morning"]::before {
    background-image: url('/pastel-footer-morning.png');
  }

  .footer[data-timeofday="noon"]::before {
    background-image: url('/pastel-footer-noon.png');
  }

  .footer[data-timeofday="evening"]::before {
    background-image: url('/pastel-footer-evening.png');
  }

  .footer[data-timeofday="night"]::before {
    background-image: url('/pastel-footer-night.png');
  }

  .footer > .container {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    min-height: 340px;
  }

  .footer .logo {
    margin-bottom: 4px;
  }

  .footer .logo-text {
    color: #ffffff;
    font-size: 4rem;
    line-height: 1;
  }

  .footer-legal {
    display: flex;
    gap: 24px;
    margin-bottom: 14px;
  }

  .footer-legal a {
    color: #ffffff;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-legal a:hover {
    color: #ffffff;
  }

</style>
