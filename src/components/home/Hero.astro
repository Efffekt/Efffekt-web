---
import Icon from '../icons/Icon.astro';
---

<section class="hero-wrapper">
  <!-- Background layer (masked, decorative only) -->
  <div class="hero-bg" aria-hidden="true"></div>

  <!-- Content layer (not masked, supports sticky) -->
  <div class="hero-content">
    <!-- Centered headline at top -->
    <div class="hero-headline">
      <h1 class="hero-title split-letters">Efffekt</h1>
    </div>

    <div class="hero-grid">

      <!-- Left: spacer for scroll room -->
      <div class="hero-left-spacer"></div>

      <!-- Right: sticky glass mission card -->
      <div class="hero-right-card">
        <div class="mission-card liquid-glass">
          <h2 class="mission-title split-words">Teknologi som gir små bedrifter superkrefter</h2>
          <p class="mission-body">
            Vi gir små og mellomstore bedrifter tilgang til de samme digitale verktøyene som de store — slik at du kan fokusere på det du gjør best.
          </p>
          <a href="#kontakt" class="mission-link">
            Book en uforpliktende prat
            <span class="mission-link-circle">
              <Icon name="arrow-right" size={12} />
            </span>
          </a>
          <p class="mission-trust">Ingen bindingstid · Svar innen 24t</p>
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  function initTimeOfDay(): void {
    const heroBg = document.querySelector('.hero-bg') as HTMLElement;
    if (!heroBg) return;

    const hour = new Date().getHours();
    let period: string;
    if (hour >= 6 && hour < 12) {
      period = 'morning';
    } else if (hour >= 12 && hour < 17) {
      period = 'noon';
    } else if (hour >= 17 && hour < 21) {
      period = 'evening';
    } else {
      period = 'night';
    }
    heroBg.setAttribute('data-timeofday', period);
    document.documentElement.setAttribute('data-timeofday', period);
  }

  initTimeOfDay();
  document.addEventListener('astro:page-load', initTimeOfDay);

</script>

<style>
  /* ===== Hero Wrapper ===== */
  .hero-wrapper {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: visible;
    z-index: 10;
  }

  /* ===== Background layer (absolute, masked) ===== */
  .hero-bg {
    position: absolute;
    inset: 0;
    background-color: #02090b;
    background-image: url('/pastel-hero-night.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .hero-bg[data-timeofday="morning"] {
    background-image: url('/pastel-hero-morning.webp');
  }

  .hero-bg[data-timeofday="noon"] {
    background-image: url('/pastel-hero-noon.webp');
  }

  .hero-bg[data-timeofday="evening"] {
    background-image: url('/pastel-hero-evening.webp');
  }

  .hero-bg[data-timeofday="night"] {
    background-image: url('/pastel-hero-night.webp');
  }

  /* ===== Content layer (above bg, not masked) ===== */
  .hero-content {
    position: relative;
    z-index: 1;
    padding: 7rem 2rem 50px;
    width: 100%;
  }

  /* ===== Two-column grid ===== */
  .hero-grid {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ===== Centered headline ===== */
  .hero-headline {
    text-align: center;
    margin-bottom: 4rem;
  }

  /* ===== Left column: Spacer for scroll room ===== */
  .hero-left-spacer {
    padding-top: 6vh;
    padding-bottom: 75vh;
  }

.hero-title {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    font-weight: 700;
    color: #fff;
    margin: 0;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.6);
    letter-spacing: -0.02em;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 0.85; transform: translateY(0); }
  }

  /* ===== Right column: Sticky Glass Mission Card ===== */
  .hero-right-card {
    position: sticky;
    top: 32vh;
    padding-top: 6vh;
    margin-right: -18rem;
  }

  .mission-card {
    max-width: 540px;
    width: 100%;
    padding: 2.5rem;
    /* Glass styling handled by .liquid-glass class */

    /* Entrance */
    opacity: 0;
    transform: translateY(20px);
    animation: cardIn 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
  }
  /* ::before handled by .liquid-glass */

  @keyframes cardIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .mission-title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--card-text, #fff);
    transition: color 0.1s ease;
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }

  .mission-body {
    font-size: 0.925rem;
    line-height: 1.7;
    color: var(--card-text-muted, #fff);
    transition: color 0.1s ease;
    margin: 0 0 2rem;
  }

  .mission-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--card-text, #fff);
    transition: color 0.1s ease;
    text-decoration: none;
    transition: gap 0.3s ease;
  }

  .mission-link:hover {
    gap: 0.85rem;
  }

  .mission-link-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .mission-link-circle :global(svg) {
    color: var(--card-text, #fff);
    transition: color 0.1s ease;
    width: 12px;
    height: 12px;
  }

  .mission-link:hover .mission-link-circle {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .mission-trust {
    font-size: 0.7rem;
    color: var(--card-text-muted, #fff);
    opacity: 0.4;
    margin: 1rem 0 0;
    letter-spacing: 0.02em;
  }

  /* ===== Responsive ===== */
  @media (max-width: 960px) {
    .hero-content {
      padding-bottom: 6rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-left-spacer {
      padding-top: 0;
      padding-bottom: 0;
      order: 2;
      display: none;
    }

    .hero-right-card {
      position: relative;
      top: auto;
      padding-top: 0;
      margin-right: 0;
      order: 1;
    }

    .mission-card {
      max-width: 420px;
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 7rem 1.5rem 5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-content {
      padding: 6rem 1.25rem 4rem;
    }

    .mission-card {
      padding: 1.75rem;
    }
  }

  @media (min-width: 1920px) {
    .hero-content {
      min-height: 70vh;
    }
  }

  @media (min-width: 2560px) {
    .hero-content {
      min-height: 60vh;
    }
  }
</style>
