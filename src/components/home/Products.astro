---
import Icon from '../icons/Icon.astro';

const services = [
  {
    icon: 'globe',
    name: 'Nettside',
    description: 'Raske, mobilvennlige nettsider bygget for konvertering.',
    href: '/nettside'
  },
  {
    icon: 'plug',
    name: 'Integrasjon',
    description: 'Koble sammen systemer så data flyter automatisk.',
    href: '/integrasjon'
  },
  {
    icon: 'laptop-code',
    name: 'Plugin',
    description: 'Skreddersydd funksjonalitet på eksisterende plattformer.',
    href: '/plugin'
  },
  {
    icon: 'robot',
    name: 'AI-automatisering',
    description: 'Automatiser repeterende oppgaver med AI.',
    href: '/ai'
  },
  {
    icon: 'server',
    name: 'Skreddersydd system',
    description: 'Helhetlige løsninger tilpasset din virksomhet.',
    href: '/system'
  },
  {
    icon: 'headset',
    name: 'Support & vedlikehold',
    description: 'Løpende oppfølging, oppdateringer og drift.',
    href: '#kontakt'
  }
];
---

<!-- Vision -->
<section id="hvordan" class="section process-section">
  <!-- Decorative divider lines -->
  <div class="hero-divider" aria-hidden="true">
    <span class="divider-line line-5"></span>
    <span class="divider-line line-4"></span>
    <span class="divider-line line-3"></span>
    <span class="divider-line line-2"></span>
    <span class="divider-line line-1"></span>
  </div>
  <div class="container">
    <div class="vision-split">
      <div class="vision-text reveal">
        <p class="editorial-statement split-words">Du har ideen. Vi bygger løsningen.</p>
        <p class="editorial-body">Vi hjelper ambisiøse bedrifter med å gå fra idé til ferdig digitalt produkt — raskt, skreddersydd og uten unødvendig kompleksitet.</p>
      </div>
      <div class="vision-illustration reveal">
        <div class="vision-img-wrapper">
          <img src="/iconbg1.png" alt="Idé til løsning" class="vision-img" />
          <svg class="vision-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="white" aria-hidden="true">
            <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13h-5a.5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm3 8.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1-.5-.5z"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Vision 2 -->
<section class="section vision2-section">
  <div class="container">
    <div class="vision-split vision-split-reverse">
      <div class="vision-illustration reveal">
        <div class="vision-img-wrapper">
          <img src="/iconbg2.png" alt="Vekst og utvikling" class="vision-img" />
          <svg class="vision-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="white" aria-hidden="true">
            <path d="M256 256c-13.47 0-26.94-2.39-37.44-7.17l-148-67.49C63.79 178.26 48 169.25 48 152.24s15.79-26 22.58-29.12l148-67.48c20.99-9.57 53.87-9.57 74.86 0l148 67.48C448.21 126.22 464 135.23 464 152.24s-15.79 26.02-22.58 29.11l-148 67.48C282.94 253.61 269.47 256 256 256zm0 68l-148-67.48C101.21 253.44 85.42 244.43 78.63 241.31L48 228.24 48 304.24c0 17.01 15.79 26.02 22.58 29.11l148 67.49c20.99 9.57 53.87 9.57 74.86 0l148-67.49C448.21 330.26 464 321.25 464 304.24V228.24l-30.63 13.07c-6.79 3.12-22.58 12.13-22.58 12.13L256 324z"/>
          </svg>
        </div>
      </div>
      <div class="vision-text reveal">
        <p class="editorial-statement split-words">Bygget for vekst, ikke bare lansering.</p>
        <p class="editorial-body">Vi lager ikke bare nettsider — vi bygger digitale plattformer som vokser med bedriften din. Alt vi leverer inkluderer vedlikehold, oppdateringer og support.</p>
      </div>
    </div>
  </div>
</section>

<!-- Tjenester -->
<section id="tjenester" class="section services-section">
  <div class="container">
    <div class="services-header reveal">
      <p class="editorial-statement split-words">Det vi kan hjelpe deg med</p>
      <p class="editorial-body">Alt inkluderer vedlikehold, support og kontinuerlige forbedringer.</p>
    </div>

    <div class="services-grid">
      {services.map((service, index) => (
        <a href={service.href} class="service-card reveal" style={`animation-delay: ${index * 0.07}s`}>
          <h3>{service.name}</h3>
          <p>{service.description}</p>
          <div class="service-card-icon">
            <Icon name={service.icon} size={16} />
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── Vision / Process Section ── */
  /* ── Divider lines (transition from hero) ── */
  .hero-divider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .divider-line {
    display: block;
    width: 100%;
    height: 7px;
  }

  /* line-5 is at top (closest to hero), fading to white at line-1 */
  .line-5 { background: rgba(var(--divider-rgb), 1); }
  .line-4 { background: rgba(var(--divider-rgb), 0.65); }
  .line-3 { background: rgba(var(--divider-rgb), 0.35); }
  .line-2 { background: rgba(var(--divider-rgb), 0.15); }
  .line-1 { background: rgba(var(--divider-rgb), 0.05); }

  .process-section {
    position: relative;
    padding-top: 16rem;
    padding-bottom: 14rem;
    background: #fff;
  }

  .vision-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }

  .vision-text .editorial-statement {
    color: var(--text);
    margin-bottom: 2.5rem;
  }

  .vision-text .editorial-body {
    margin-bottom: 0;
  }

  .vision-illustration {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vision-img-wrapper {
    position: relative;
    display: inline-block;
    max-width: 420px;
    width: 100%;
  }

  .vision-img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    display: block;
  }

  .vision-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 30%;
    height: 30%;
    opacity: 0.85;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.15));
  }

  .vision-pullquote {
    color: var(--text);
    margin-top: 3.5rem;
  }

  /* Reverse layout: text left, image right */
  .vision-split-reverse {
    direction: ltr;
  }

  /* Vision 2 section */
  .vision2-section {
    position: relative;
    padding-top: 0;
    padding-bottom: 10rem;
    background: #fff;
  }

  .vision2-section .vision-text .editorial-statement {
    color: var(--text);
    margin-bottom: 2.5rem;
  }

  .vision2-section .vision-text .editorial-body {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .process-section {
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .vision-split {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .vision-img {
      max-width: 300px;
      margin: 0 auto;
    }

    .vision-split-reverse .vision-illustration {
      order: 2;
    }

    .vision-split-reverse .vision-text {
      order: 1;
    }

    .vision-pullquote {
      margin-top: 2rem;
    }

    .vision2-section {
      padding-bottom: 5rem;
    }
  }

  /* ── Services Section ── */
  .services-section {
    position: sticky;
    top: 15vh;
    z-index: 0;
    padding-top: 6rem;
    padding-bottom: 6rem;
    margin-bottom: 50vh;
    background: #fff;
  }

  .services-header {
    margin-bottom: 3.5rem;
  }

  .services-header .editorial-statement {
    color: #1a1a1a;
    margin-bottom: 1.5rem;
  }

  .services-header .editorial-body {
    color: #6b7280;
    margin-bottom: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s var(--ease-out);
  }

  .service-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .service-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .service-card p {
    color: #6b7280;
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .service-card-icon {
    margin-top: 16px;
    width: 28px;
    height: 28px;
    background: #f3f4f6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-card-icon :global(svg) {
    width: 14px;
    height: 14px;
    color: #6b7280;
  }


  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
