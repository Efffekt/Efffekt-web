---
// Full-width banner image section with glass card overlay
import Icon from '../icons/Icon.astro';
---

<section class="banner-section">
  <div class="container">
    <div class="banner-wrapper">
      <img src="/pastel-banner.png" alt="" class="banner-img" />
      <div class="banner-card">
        <h2 class="banner-card-title split-words">Sjekk nettsiden din gratis</h2>
        <p class="banner-card-body">Få en komplett analyse av hastighet, SEO, sikkerhet og mobilvennlighet — på sekunder.</p>

        <form class="banner-scanner-form" action="/scan" method="GET">
          <input type="text" name="url" placeholder="dinside.no" required />
          <button type="submit" class="banner-btn">
            Analyser
            <Icon name="arrow-right" size={16} />
          </button>
        </form>
      </div>
    </div>
  </div>
  <div class="banner-after"></div>
</section>

<style>
  .banner-section {
    position: relative;
    z-index: 1;
    background: transparent;
    padding: 0;
  }

  .banner-after {
    height: 6rem;
    background: #fff;
  }

  .banner-section > .container {
    max-width: 1300px;
  }

  .banner-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 620px;
    overflow: hidden;
    border-radius: 16px;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .banner-card {
    position: relative;
    max-width: 1100px;
    width: 95%;
    border-radius: 1rem;
    padding: 7rem 7rem 8rem;
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.12),
        rgba(0, 0, 0, 0.07) 50%,
        rgba(0, 0, 0, 0.07)
      );
    background-clip: padding-box;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.20);
    box-shadow: 0 2px 6px 0 rgba(0, 0, 0, 0.15);
    text-align: center;
  }

  /* Subtle top-edge specular highlight */
  .banner-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.15) 30%,
      rgba(255, 255, 255, 0.15) 70%,
      transparent
    );
    border-radius: 1px;
  }

  .banner-card-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
    margin: 0 0 1.25rem;
    letter-spacing: -0.01em;
  }

  .banner-card-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 2.5rem;
  }

  /* Scanner form */
  .banner-scanner-form {
    display: flex;
    gap: 10px;
    padding: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
  }

  .banner-scanner-form input {
    flex: 1;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    color: #fff;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.3s ease;
  }

  .banner-scanner-form input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .banner-scanner-form input:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 16px 32px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: inherit;
    color: #fff;
    background: #2d2d2d;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .banner-btn:hover {
    background: #3a3a3a;
    transform: translateY(-1px);
  }

  .banner-btn :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 768px) {
    .banner-card {
      max-width: none;
      width: 90%;
      padding: 2rem;
    }

    .banner-scanner-form {
      flex-direction: column;
    }

    .banner-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
