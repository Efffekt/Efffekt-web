---
// Portfolio / Showcase section — bento grid with blurred bg + sharp overlay
---

<section id="portefolje" class="section">
  <div class="container">
    <div class="bento-grid">
      {/* Row 1: two large side by side */}
      <div class="project-card bento-wide reveal">
        <div class="project-visual">
          <img src="/treallservice.png" alt="" class="project-bg" aria-hidden="true" />
          <div class="project-frame">
            <img src="/treallservice.png" alt="TRE Allservice AS" class="project-screen" loading="lazy" />
          </div>
          <div class="project-bar">
            <div class="bar-left">
              <span class="bar-label">Kundeportal</span>
              <span class="bar-divider"></span>
              <span class="project-status">Produksjon</span>
            </div>
            <a href="https://trekontroll.no" target="_blank" rel="noopener" class="project-live">Se live</a>
          </div>
        </div>
      </div>

      <div class="project-card bento-wide reveal" style="animation-delay: 0.12s">
        <div class="project-visual">
          <img src="/preik.png" alt="" class="project-bg" aria-hidden="true" />
          <div class="project-frame">
            <img src="/preik.png" alt="Preik.ai" class="project-screen" loading="lazy" />
          </div>
          <div class="project-bar">
            <div class="bar-left">
              <span class="bar-label">AI-chatbot</span>
              <span class="bar-divider"></span>
              <span class="project-status">Produksjon</span>
            </div>
            <a href="https://preik.ai" target="_blank" rel="noopener" class="project-live">Se live</a>
          </div>
        </div>
      </div>

      {/* Row 2: RK + SkyPlanner stacked left, Chatbot tall right */}
      <div class="bento-stack">
        <div class="project-card reveal" style="animation-delay: 0.24s">
          <div class="project-visual">
            <img src="/rk.png" alt="" class="project-bg" aria-hidden="true" />
            <div class="project-frame">
              <img src="/rk.png" alt="RK" class="project-screen" loading="lazy" />
            </div>
            <div class="project-bar">
              <div class="bar-left">
                <span class="bar-label">Nettside</span>
                <span class="bar-divider"></span>
                <span class="project-status">Produksjon</span>
              </div>
              <a href="#" class="project-live">Se live</a>
            </div>
          </div>
        </div>
        <div class="project-card reveal" style="animation-delay: 0.36s">
          <div class="project-visual">
            <img src="/skyplanner.png" alt="" class="project-bg" aria-hidden="true" />
            <div class="project-frame">
              <img src="/skyplanner.png" alt="SkyPlanner" class="project-screen" loading="lazy" />
            </div>
            <div class="project-bar">
              <div class="bar-left">
                <span class="bar-label">System</span>
                <span class="bar-divider"></span>
                <span class="project-status">Produksjon</span>
              </div>
              <a href="#" class="project-live">Se live</a>
            </div>
          </div>
        </div>
      </div>

      <div class="project-card bento-tall reveal" style="animation-delay: 0.3s">
        <div class="project-visual">
          <img src="/chatbot.png" alt="" class="project-bg" aria-hidden="true" />
          <div class="project-frame">
            <img src="/chatbot.png" alt="Chatbot" class="project-screen" loading="lazy" />
          </div>
          <div class="project-bar">
            <div class="bar-left">
              <span class="bar-label">AI-assistent</span>
              <span class="bar-divider"></span>
              <span class="project-status">Produksjon</span>
            </div>
            <a href="#" class="project-live">Se live</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #portefolje {
    background: #fff;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .bento-wide {
    grid-column: span 1;
  }

  .bento-stack {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .bento-tall {
    grid-column: span 1;
  }

  .bento-tall .project-visual {
    height: 100%;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  /* Visual container */
  .project-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
    border-radius: 8px;
    overflow: hidden;
  }

  /* Blurred expanded background */
  .project-bg {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    object-fit: cover;
    filter: blur(20px) saturate(1.2);
    transform: scale(1.1);
    z-index: 0;
  }

  .project-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.08);
    z-index: 1;
  }

  /* Sharp foreground frame */
  .project-frame {
    position: relative;
    z-index: 2;
    width: 88%;
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      0 0 0 1px rgba(255, 255, 255, 0.15);
  }

  .project-screen {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Floating glass bar — hidden by default, appears on hover */
  .project-bar {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 1.25rem;
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.45),
        rgba(0, 0, 0, 0.35) 50%,
        rgba(0, 0, 0, 0.35)
      );
    background-clip: padding-box;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.20);
    border-radius: 100px;
    box-shadow: 0 2px 6px 0 rgba(0, 0, 0, 0.15);
    opacity: 0;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }

  .project-card:hover .project-bar {
    opacity: 1;
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .bar-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
  }

  .bar-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.25);
  }

  .project-status {
    font-size: 0.75rem;
    font-weight: 500;
    color: #fff;
  }

  .project-live {
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .bento-tall .project-visual {
      height: auto;
    }
  }
</style>
