---
import Icon from '../icons/Icon.astro';
---

<section id="scanner" class="section scanner-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-label">Gratis analyse</span>
      <h2 class="efffekt-bar">Sjekk nettsiden din</h2>
      <p>Få en komplett analyse av hastighet, SEO, sikkerhet og mobilvennlighet.</p>
    </div>

    <div class="scanner-box reveal">
      <form id="scannerForm" class="scanner-form">
        <label for="scannerUrl" class="sr-only">Skriv inn nettadresse</label>
        <input type="text" id="scannerUrl" placeholder="dinside.no" required />
        <button type="submit" class="btn btn-primary">
          <span class="btn-text">Analyser</span>
          <span class="btn-loading">
            <Icon name="spinner" size={14} />
            Analyserer...
          </span>
        </button>
      </form>
    </div>

    <div id="scannerResults" class="scanner-results" style="display: none;"></div>
  </div>
</section>

<style>
  .scanner-section {
    padding: 120px 0;
    background: var(--bg);
  }
</style>

<script>
  import { initScanner } from './scanner-logic';

  initScanner();
  document.addEventListener('astro:page-load', initScanner);
</script>
