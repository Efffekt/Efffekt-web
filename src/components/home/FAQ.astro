---
import Icon from '../icons/Icon.astro';

const faqs = [
  {
    question: 'Hva er inkludert?',
    answer: 'Alt du trenger: hosting, vedlikehold, sikkerhetskopier, oppdateringer og kontinuerlige forbedringer. Support er alltid inkludert.'
  },
  {
    question: 'Er det bindingstid?',
    answer: 'Nei. Du kan avslutte når som helst med én måneds varsel. Vi tror på å levere så god verdi at du velger å bli.'
  },
  {
    question: 'Hvordan fungerer den gratis demoen?',
    answer: 'Vi bygger en fungerende prototype basert på dine behov — helt gratis. Du tester løsningen med egne data før du bestemmer deg. Liker du det, starter vi samarbeidet. Hvis ikke, har du ikke tapt noe.'
  },
  {
    question: 'Hvem eier løsningen?',
    answer: 'Du eier all data og innhold. Avslutter du, får du eksportert alt du trenger. Vi tilbyr også mulighet for å kjøpe ut kildekoden.'
  },
  {
    question: 'Hva skjer hvis noe går galt?',
    answer: 'Vi overvåker alle løsninger 24/7 med automatiske sikkerhetskopier daglig. Ved problemer varsles vi umiddelbart og fikser det — vanligvis før du merker noe.'
  },
  {
    question: 'Hva om løsningen ikke passer for oss?',
    answer: 'Du tester alltid gratis først med en fungerende prototype. Er du ikke fornøyd, har du ikke forpliktet deg til noe. Ingen risiko, ingen bindingstid.'
  },
  {
    question: 'Hvor lang tid tar det å få en ferdig løsning?',
    answer: 'Det avhenger av kompleksiteten, men de fleste prosjekter er klare innen 2–6 uker. Du får en fungerende prototype allerede etter første uke, slik at du kan gi tilbakemelding tidlig.'
  },
  {
    question: 'Kan jeg oppdatere innholdet selv?',
    answer: 'Ja. Vi setter opp et brukervennlig innholdssystem tilpasset dine behov, slik at du enkelt kan endre tekst, bilder og annet innhold uten teknisk kompetanse.'
  },
  {
    question: 'Hva med SEO og ytelse?',
    answer: 'Alle løsninger bygges med rask lastetid, ren kode og søkemotoroptimalisering fra dag én. Vi følger beste praksis for Core Web Vitals, tilgjengelighet og teknisk SEO.'
  },
  {
    question: 'Kan dere integrere med systemer vi allerede bruker?',
    answer: 'Absolutt. Vi har erfaring med de fleste CRM-, ERP- og betalingsløsninger. Vi kobler sammen systemene dine slik at data flyter automatisk og du slipper dobbeltarbeid.'
  }
];
---

<section id="faq" class="section">
  <div class="container">
    <div class="faq-grid">
      <div class="faq-left reveal">
        <p class="editorial-statement split-words">Ofte stilte spørsmål</p>
        <p class="editorial-body">Det meste du lurer på, samlet på ett sted.</p>
        <a href="#kontakt" class="faq-cta-link">
          Spør oss direkte
          <span class="faq-cta-circle">
            <Icon name="arrow-right" size={12} />
          </span>
        </a>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <div class="faq-item reveal" style={`animation-delay: ${index * 0.05}s`}>
            <button class="faq-question" aria-expanded="false">
              <span>{faq.question}</span>
              <Icon name="chevron-down" size={20} />
            </button>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // FAQ toggle - global event delegation med guard mot multiple registreringer
  if (!window.__faqInitialized) {
    window.__faqInitialized = true;
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.faq-question');
      if (!btn) return;

      e.preventDefault();
      var item = btn.parentElement;
      if (!item) return;

      var isOpen = item.classList.contains('open');

      // Lukk alle åpne FAQ-items
      document.querySelectorAll('.faq-item.open').forEach(function(el) {
        el.classList.remove('open');
        var elBtn = el.querySelector('.faq-question');
        if (elBtn) elBtn.setAttribute('aria-expanded', 'false');
      });

      // Åpne denne hvis den ikke var åpen
      if (!isOpen) {
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>

<style>
  #faq {
    background: #fff;
  }
</style>
